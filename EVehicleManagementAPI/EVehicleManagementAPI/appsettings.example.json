{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=EVehicleDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "EmailSettings": {
    "Username": "your-email@gmail.com",
    "Password": "your-app-password"
  },
